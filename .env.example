# Application
REELIO_ENVIRONMENT=local
REELIO_LOG_LEVEL=INFO

# Transcription
REELIO_MAX_VIDEO_DURATION_SECONDS=1800
REELIO_TEMP_MEDIA_DIR=
REELIO_WHISPER_MODEL=large-v3-turbo
REELIO_WHISPER_DEVICE=cuda
REELIO_WHISPER_COMPUTE_TYPE=float16
REELIO_WHISPER_BEAM_SIZE=1
REELIO_WHISPER_VAD_FILTER=True
REELIO_WHISPER_TEMPERATURE=0.0
REELIO_WHISPER_COND_ON_PREV_TXT=True
REELIO_WHISPER_MAX_CONCURRENT=1
# Hugging Face API token
HF_TOKEN=

# Mention interpretation
# Select exactly one provider with REELIO_LLM_PROVIDER.
# Only the selected provider requires a non-blank API key.
REELIO_LLM_PROVIDER=deepseek
REELIO_MAX_SOURCE_TITLE_CHARS=500
REELIO_MAX_DESCRIPTION_CHARS=2000
REELIO_MAX_TRANSCRIPT_LANGUAGE_CHARS=64
REELIO_MAX_TRANSCRIPT_CHARS=100000

# OpenAI Mention interpretation
REELIO_OPENAI_API_KEY=
REELIO_OPENAI_MODEL=gpt-5-nano
REELIO_OPENAI_REASONING_EFFORT=low
REELIO_OPENAI_REQUEST_TIMEOUT_SECONDS=60
REELIO_OPENAI_MAX_OUTPUT_TOKENS=8192
REELIO_OPENAI_MAX_RETRIES=2

# DeepSeek Mention interpretation
REELIO_DEEPSEEK_API_KEY=
REELIO_DEEPSEEK_BASE_URL=https://api.deepseek.com
REELIO_DEEPSEEK_MODEL=deepseek-v4-flash
REELIO_DEEPSEEK_REQUEST_TIMEOUT_SECONDS=60
REELIO_DEEPSEEK_TEMPERATURE=0.0
REELIO_DEEPSEEK_MAX_OUTPUT_TOKENS=8192
REELIO_DEEPSEEK_MAX_RETRIES=2

# MusicBrainz Track resolution
# Identify your application and operator contact: application/version (contact).
REELIO_MUSICBRAINZ_USER_AGENT=reelio/0.1 (contact@example.com)
REELIO_MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
REELIO_MUSICBRAINZ_REQUEST_TIMEOUT_SECONDS=20

# TMDB (v4 read access token)
REELIO_TMDB_API_KEY=
REELIO_TMDB_BASE_URL=https://api.themoviedb.org/3
REELIO_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
REELIO_TMDB_REQUEST_TIMEOUT_SECONDS=10
